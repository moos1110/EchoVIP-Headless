TZ=Asia/Shanghai
DATA_DIR=./data
LOG_DIR=./logs
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=2
LOG_LEVEL=info
# 可选；默认直连，不继承系统或终端的 HTTP_PROXY/HTTPS_PROXY
# Docker 中请使用容器可访问的地址（Windows/macOS 通常是 host.docker.internal）
KUGOU_API_PROXY=

# Web 面板；不得使用服务器系统密码，不得提交真实值
APP_MODE=provisioning
ACCOUNTS_DIR=./accounts
CONTROL_DIR=./control-data
WEB_HOST=127.0.0.1
WEB_PORT=8787
# 可在本地准备阶段提前填写；这里只写纯域名，不带 https:// 或路径
PANEL_DOMAIN=
# 可选；留空时会根据 PANEL_DOMAIN 自动使用 https://<域名>
PUBLIC_BASE_URL=
PANEL_PASSWORD=
SESSION_SECRET=
# 本地 HTTP 使用 false；服务器经 HTTPS 域名访问时必须为 true
SECURE_COOKIES=false
